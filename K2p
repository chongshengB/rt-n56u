#!/bin/bash
sudo apt 更新
sudo apt install unzip libtool-bin curl cmake gperf gawk flex bison nano xxd cpio git python3-docutils gettext automake autopoint texinfo build-essential help2man pkg-config zlib1g-dev libgmp3-dev libmpc-dev libmpfr-dev libncurses5-dev libltdl-dev fakeroot -y

# 拉取 chongshengB 最新rt-n56u仓库
sudo git clone --depth=1 https://gitee.com/chongshengB/rt-n56u.git /opt/rt-n56u
sudo chmod 777 /opt -R
cd /opt/rt-n56u
git pull

# 写入K2P完整版配置（26.9.1，全套插件+IPv6）
cat > /opt/rt-n56u/trunk/configs/templates/K2P.config <<'EOF'
#
# Phicomm K2P A1/A2，采用MT7621芯片，内存为16M/256M｜Padavan 3.4.3.9-26.9.1版本
# H大全套插件 + 开启IPv6
#
CONFIG_TARGET_K2P=y
CONFIG_FIRMWARE_NAME="Padavan-K2P-Hiboy26.9.1-完整IPv6版本"
CONFIG_FIRMWARE_VERSION="3.4.3.9-26.9.1"
CONFIG_FIRMWARE_BUILD_DATE="自动构建"

#硬件
CONFIG_RALINK_MT7621=y
CONFIG_RAM_SIZE=256
CONFIG_FLASH_SIZE=16
CONFIG_SPI_FLASH=y
CONFIG_ETH_MT7621=y
CONFIG_WIFI_2G_MT7603E=y
CONFIG_WIFI_5G_MT7612E=y
CONFIG_WIFI_REG_DOMAIN=CN
CONFIGPHY_RGMII=y

#系统基础组件
CONFIG_FIRMWARE_INCLUDE_WING=y
CONFIG_FIRMWARE_INCLUDE_SWIOTLB=y
CONFIG_FIRMWARE_INCLUDE_LOG=y
CONFIG_FIRMWARE_INCLUDE_LOGSYSTEM=y
CONFIG_FIRMWARE_INCLUDE_HTOP=y
CONFIG_FIRMWARE_INCLUDE_NANO=y
CONFIG_FIRMWARE_INCLUDE_TCPDUMP=y
CONFIG_FIRMWARE_INCLUDE_WIFIDOG=y
CONFIG_FIRMWARE_INCLUDE_MTR=y
CONFIG_FIRMWARE_INCLUDE_SOCINFO=y
CONFIG_FIRMWARE_INCLUDE_NETBIOS=y
CONFIG_FIRMWARE_INCLUDE_LLTD=y
CONFIG_FIRMWARE_INCLUDE_DDNS_SYNCOLOIP=y

#网络QoS
CONFIG_FIRMWARE_INCLUDE_SQM=y
CONFIG_FIRMWARE_INCLUDE_CAKE=y
CONFIG_FIRMWARE_INCLUDE_BBR=y
CONFIG_FIRMWARE_INCLUDE_FQ_Codel=y

#科学套件
CONFIG_FIRMWARE_INCLUDE_SHADOWSOCKS=y
CONFIG_FIRMWARE_INCLUDE_SSSERVER=y
CONFIG_FIRMWARE_INCLUDE_V2RAY=y
CONFIG_FIRMWARE_INCLUDE_TROJAN=y
CONFIG_FIRMWARE_INCLUDE_SOFTETHERVPN_SERVER=y
CONFIG_FIRMWARE_INCLUDE_SOFTETHERVPN_CLIENT=y

#内网穿透
CONFIG_FIRMWARE_INCLUDE_FRPC=y
CONFIG_FIRMWARE_INCLUDE_FRPS=y
CONFIG_FIRMWARE_INCLUDE_ZEROTIER=y

#媒体共享
CONFIG_FIRMWARE_INCLUDE_SAMBA=y
CONFIG_FIRMWARE_INCLUDE_AVAHI=y
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=y
CONFIG_FIRMWARE_INCLUDE_FTP=y
CONFIG_FIRMWARE_INCLUDE_WEBDAV=y

#广告过滤&解锁
CONFIG_FIRMWARE_INCLUDE_ADGUARDHOME=y
CONFIG_FIRMWARE_INCLUDE_ALIDDNS=y
CONFIG_FIRMWARE_INCLUDE_NETEASE_UNLOCK=y

#开启IPv6
CONFIG_FIRMWARE_INCLUDE_IPV6=y

#关闭老旧VPN
CONFIG_FIRMWARE_EXCLUDE_PPTP=y
CONFIG_FIRMWARE_EXCLUDE_L2TP=y
#关闭Docker（K2P内存不足）
# CONFIG_FIRMWARE_INCLUDE_DOCKER=y

#网页主题
CONFIG_FIRMWARE_INCLUDE_THEME_HIBOY=y
CONFIG_FIRMWARE_DEFAULT_LANG=zh-cn
EOF

# 下载交叉工具链
cd /opt/rt-n56u/toolchain-mipsel
sh dl_toolchain.sh

# 开始编译
cd /opt/rt-n56u/trunk
sudo./clear_tree
sudo./build_firmware_modify K2P
echo -e "\n✅【26.9.1完整版带IPv6】编译完成！固件目录：/opt/rt-n56u/trunk/images/"
